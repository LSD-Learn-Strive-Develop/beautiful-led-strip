# Environment Configuration

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ADMIN_ID=0
# Optional SOCKS5 or HTTP CONNECT proxy; leave empty for direct access.
# Example: socks5://user:password@proxy.example.com:1080
TELEGRAM_PROXY_URL=

# Yandex Weather API
YANDEX_WEATHER_API_KEY=your_weather_api_key
YANDEX_WEATHER_LAT=59.873546
YANDEX_WEATHER_LON=29.827624

# LED Configuration
LED_PIN=D18
LED_COUNT=392

# New Year countdown (format: YYYY-MM-DD HH:MM:SS)
NEW_YEAR_DATE=2026-01-01 00:00:00
